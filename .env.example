# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/medicare

# JWT Secret
JWT_SECRET=your-random-jwt-secret-here-minimum-32-characters

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-nextauth-secret-here-minimum-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Emergency Services
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
SENDGRID_API_KEY=your-sendgrid-api-key
EMERGENCY_EMAIL=emergency@yourdomain.com

# App Configuration
NODE_ENV=development
EMERGENCY_MODE=development

NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
